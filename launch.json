{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "renderer",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "--prefix", "MotionCaption/app", "dev:web"],
      "port": 5180
    },
    {
      "name": "renderer-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "--prefix", "MotionCaption/app", "dev:web", "--", "--port", "5181"],
